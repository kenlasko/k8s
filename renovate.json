{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":rebaseStalePrs"
  ],
  "pre-commit": {
    "enabled": true
  },
  "enabledManagers": [
    "custom.regex",
    "helm-values",
    "kubernetes",
    "kustomize",
    "pre-commit"
  ],
  "helm-values": {
    "managerFilePatterns": [
      "/^manifests/.*values.*\\.yaml$/"
    ],
    "ignorePaths": [
      "archive/**"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": [
      "/deploy/",
      "/cronjob/",
      "/tunnel/"
    ],
    "ignorePaths": [
      "**/*patch*.yaml",
      "archive/**"
    ]
  },
  "kustomize": {
    "managerFilePatterns": [
      "/kustomization/",
      "/patch/"
    ],
    "ignorePaths": [
      "archive/**"
    ]
  },
  "hostRules": [
    {
      "hostType": "docker",
      "matchHost": "docker.io",
      "username": "kenlasko",
      "password": "{{ secrets.DOCKER_CREDS }}"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/cluster/"
      ],
      "matchStrings": [
        "imageName:\\s*kenlasko/cloudnativepg-gis-vchord:(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "packageNameTemplate": "kenlasko/cloudnativepg-gis-vchord"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/kustomization\\.yaml/"
      ],
      "matchStrings": [
        "cloudnative-pg/plugin-barman-cloud/releases/download/v(?<currentValue>.*?)/manifest.yaml"
      ],
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "cloudnative-pg/plugin-barman-cloud"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)cluster-[^/]+\\.yaml$/"
      ],
      "matchStrings": [
        "ghcr\\.io/adampetrovic/timescaledb-cnpg:(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/adampetrovic/timescaledb-cnpg"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "kustomize"
      ],
      "matchPackageNames": [
        "kube-prometheus-stack"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "helm-values",
        "kubernetes",
        "kustomize",
        "pre-commit",
        "regex"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "matchManagers": [
        "helm-values",
        "kubernetes",
        "kustomize",
        "custom.regex"
      ],
      "matchPackageNames": [
        "cloudnative-pg",
        "cloudnative-pg/plugin-barman-cloud",
        "cilium",
        "**/gateway-api.git",
        "kubernetes-sigs/gateway-api",
        "longhorn",
        "tailscale-operator",
        "ghcr.io/adampetrovic/timescaledb-cnpg"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "helm-values"
      ],
      "matchPackageNames": [
        "ghcr.io/home-operations/home-assistant"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "automerge": false
    },
    {
      "matchManagers": [
        "helm-values",
        "kubernetes"
      ],
      "matchPackageNames": [
        "ghcr.io/oracle/oci-cli",
        "ghcr.io/calibrain/calibre-web-automated-book-downloader"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "matchManagers": [
        "kustomize"
      ],
      "matchPackageNames": [
        "baseline"
      ],
      "enabled": false
    }
  ]
}
